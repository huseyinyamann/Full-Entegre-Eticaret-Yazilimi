# Kopyalayıp .env olarak kaydedin (.env git'e girmez)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yaman_eticaret
DB_USER=root
DB_PASS=

# Admin oturum çerezi yalnızca HTTPS üzerinden gönderilsin (canlıda 1 yapın)
SESSION_SECURE=0

# YALNIZCA TEST: giriş formlarını otomatik doldurur. Canlıya çıkmadan önce bu satırları boşaltın/silin.
AUTOFILL_ADMIN_EMAIL=
AUTOFILL_ADMIN_PASSWORD=
AUTOFILL_CUSTOMER_EMAIL=
AUTOFILL_CUSTOMER_PASSWORD=
